# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used in order if the main model is overloaded or times out
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TIMEOUT_S=60
# Optional: USD per 1M tokens, for cost-per-query in eval reports (0 on the free tier)
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0
